# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samanta_lms?schema=public"

# JWT secrets (generate strong random strings — min 32 chars)
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string-at-least-32"

# Access token 15 min, refresh token 30 days
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cookie settings
COOKIE_DOMAIN=""
NODE_ENV="development"

# Hostinger / S3-compatible storage (optional — files stored locally in dev)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="samanta-lms"
STORAGE_PUBLIC_URL=""

# Initial super admin (used by seed)
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_MOBILE="9999999999"

# Overdue / NPA thresholds (in days)
OVERDUE_THRESHOLD_DAYS=1
NPA_THRESHOLD_DAYS=90

# Vercel Cron secret (generate with: openssl rand -hex 16)
CRON_SECRET=""
